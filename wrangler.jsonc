{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-lanh-nghe-app",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Chạy Worker ở Singapore: Cloudflare hay đưa người dùng Việt Nam vào trạm Hong Kong (HKG),
  // mà Gemini API và OpenAI API không phục vụ yêu cầu xuất phát từ Hong Kong ("User location is not supported").
  "placement": { "region": "gcp:asia-southeast1" },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-lanh-nghe",
      "database_id": "fe5fcee3-5786-42a0-8ec4-ba7edb8907f8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://ai-lanh-nghe-app.nghoangan-bt96.workers.dev",
    "MAIL_FROM": "AI Lành Nghề <onboarding@resend.dev>",
    "TRIAL_PROVIDER": "openrouter",
    "TRIAL_MODEL": "anthropic/claude-sonnet-5.5",
    "TRIAL_FALLBACK_MODEL": "",
    "USD_VND": "26000",
    "DEMO_EMAIL_DOMAIN": "ailanhnghe.demo"
  }
}
