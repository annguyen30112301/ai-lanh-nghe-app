---
import AppShell from "../../../layouts/AppShell.astro";
import ScenarioBanner from "../../../islands/ScenarioBanner";
import Icon from "../../../components/Icon.astro";
import { app } from "../../../content/vi";
import { publicScenarios } from "../../../lib/skills";
const t = app.scenarios;
const list = publicScenarios();
const icons: Record<string, string> = { "so-sanh-bao-gia": "table", "thu-thuong-luong": "handshake", "tom-tat-ho-so-ncc": "file" };
---
<AppShell page="scenarios" title={t.title} description={t.description}>
  <div class="shell py-10 sm:py-14">
    <h1 class="t-title">{t.heading}</h1>
    <p class="t-sub mt-3">{t.lead}</p>
    <div class="mt-6"><ScenarioBanner client:load t={t} connectLabel={app.nav.connect} /></div>
    <ul class="mt-8 grid gap-4 md:grid-cols-3">
      {list.map((s) => (
        <li>
          <a href={`/app/lam-viec/?s=${s.id}`} class="glow lift panel group flex h-full flex-col p-6 text-ink no-underline">
            <span class="icon-tile"><Icon name={icons[s.id] ?? "briefcase"} size={26} /></span>
            <h2 class="mt-5 text-[1.25rem]">{s.name}</h2>
            <p class="mt-2 flex-1 text-[0.92rem] text-ink-2">{s.summary}</p>
            <p class="mt-5 flex items-center justify-between gap-3">
              <span class="chip chip-muted"><Icon name="clock" size={16} />{t.usual.replace("{n}", String(s.manual_minutes_ref))}</span>
              <span class="inline-flex items-center gap-1.5 font-semibold text-accent-ink">{t.start}<Icon name="arrow" size={18} weight="bold" class="transition-transform group-hover:translate-x-1" /></span>
            </p>
          </a>
        </li>
      ))}
    </ul>
    <h2 class="mt-12 text-[1.1rem] text-ink-2">{t.otherJobs}</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {t.others.map((o) => (
        <li class="flex items-center justify-between gap-3 rounded-3xl border border-dashed border-hair px-5 py-4 text-ink-2">
          {o}<span class="chip chip-muted">{t.soon}</span>
        </li>
      ))}
    </ul>
  </div>
</AppShell>
