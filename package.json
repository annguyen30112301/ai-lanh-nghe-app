{
  "name": "ai-lanh-nghe-app",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=db/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=db/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/react": "^7.0.1",
    "@fontsource/lexend": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "docx": "^9.10.0",
    "motion": "^14.2.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
